# Kokoon IoT Studio — frontend configuration (copy to .env.local)
# Only NON-SECRET values belong here: everything prefixed VITE_ is bundled into
# the JavaScript that ships to the browser.
# NEVER copy the backend .env here, and never put JWT secrets, database URLs,
# Redis or MQTT broker credentials, API keys or LMS tokens in this file.

# Kokoon Backend REST + SSE base URL. Sessions use HttpOnly cookies set by the
# backend, so open the app on the SAME host name the API uses (localhost with
# localhost, not 127.0.0.1 with localhost) or the browser will not send them.
VITE_API_BASE_URL=http://localhost:4004/api/v1

# Link used by the "LMS" nav item
VITE_LMS_URL=https://test.kokoon.pre.pixxo.io/
